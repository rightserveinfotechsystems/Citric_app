# Force LF on checkout for files that bash/sh executes — Windows checkouts must
# never inject CRLF (it broke the EAS iOS build: ".xcode.env: line 5: command not found")
ios/.xcode.env text eol=lf
*.sh text eol=lf
*.command text eol=lf
ios/Podfile text eol=lf
gradlew text eol=lf

# pbxproj embeds shell scripts with raw newlines — CRLF breaks them on EAS
# (".xcode.env/strip script: unexpected end of file / command not found")
*.pbxproj text eol=lf
