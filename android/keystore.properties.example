# Copy to android/keystore.properties for LOCAL (offline) release builds.
# This file must NEVER be committed — it is git-ignored.
# On EAS cloud builds this file is not used; EAS injects the keystore it manages.
#
# storeFile is resolved relative to android/app/ (the Gradle module directory).
storeFile=citric-upload.keystore
storePassword=CHANGE_ME
keyAlias=my-key-alias
keyPassword=CHANGE_ME
