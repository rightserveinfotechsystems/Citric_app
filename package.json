{
  "name": "citric_app",
  "version": "2.0.1",
  "private": true,
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "start:clear": "expo start --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint .",
    "test": "jest",
    "verify": "expo install --check && expo config --type public",
    "verify:bundle": "expo export --platform android --output-dir dist",
    "build:dev": "eas build --profile development --platform all",
    "build:dev:android": "eas build --profile development --platform android",
    "build:dev:ios": "eas build --profile development --platform ios",
    "build:preview": "eas build --profile preview --platform all",
    "build:preview:android": "eas build --profile preview --platform android",
    "build:preview:ios": "eas build --profile preview --platform ios",
    "build:production": "eas build --profile production --platform all",
    "build:production:android": "eas build --profile production --platform android",
    "build:production:ios": "eas build --profile production --platform ios",
    "release": "eas build --profile production --platform all --auto-submit-with-profile=production",
    "submit:android": "eas submit --platform android --profile production",
    "submit:ios": "eas submit --platform ios --profile production",
    "credentials:android": "eas credentials --platform android",
    "credentials:ios": "eas credentials --platform ios",
    "devices": "eas device:create",
    "clean:android": "cd android && gradlew clean",
    "eas-build-post-install": "bash scripts/eas-ios-set-version.sh"
  },
  "dependencies": {
    "@react-native-community/datetimepicker": "^8.2.0",
    "@react-native-picker/picker": "^2.9.0",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "axios": "^1.7.7",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-dev-client": "~5.0.20",
    "expo-status-bar": "~2.0.1",
    "expo-updates": "~0.27.5",
    "moment": "^2.30.1",
    "react": "18.3.1",
    "react-hook-form": "^7.53.1",
    "react-native": "0.76.9",
    "react-native-bouncy-checkbox": "^4.1.2",
    "react-native-gesture-handler": "^2.20.2",
    "react-native-picker-select": "^9.3.1",
    "react-native-reanimated": "^3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-webview": "^13.12.5",
    "react-native-woodpicker": "^0.3.17"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "15.0.0",
    "@react-native-community/cli-platform-android": "15.0.0",
    "@react-native-community/cli-platform-ios": "15.0.0",
    "@react-native/babel-preset": "0.76.1",
    "@react-native/eslint-config": "0.76.1",
    "@react-native/metro-config": "0.76.1",
    "@react-native/typescript-config": "0.76.1",
    "@types/react": "^18.2.6",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.6.3",
    "babel-preset-expo": "~12.0.0",
    "eas-cli": "^24.7.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "18.3.1",
    "typescript": "~5.3.3"
  },
  "engines": {
    "node": ">=20.18.3"
  },
  "main": "index.js"
}
