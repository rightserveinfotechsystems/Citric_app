# This `.xcode.env` file is versioned and is used to source the environment
# used when running script phases inside Xcode.
# To customize your local environment, you can create an `.xcode.env.local`
# file that is not versioned.

# Xcode script phases run with a minimal PATH (node may be missing there).
# Broaden it to every location EAS / Homebrew / nvm install node into.
if ! command -v node >/dev/null 2>&1; then
  export PATH="/usr/local/bin:/opt/homebrew/bin:/opt/homebrew/opt/node/bin:/usr/bin:/bin:/usr/sbin:/sbin:$HOME/.local/bin:$PATH"
fi
if ! command -v node >/dev/null 2>&1; then
  LATEST_NVM=$(ls -d "$HOME"/.nvm/versions/node/* 2>/dev/null | sort | tail -n 1)
  if [ -n "$LATEST_NVM" ]; then
    export PATH="$LATEST_NVM/bin:$PATH"
  fi
fi

# NODE_BINARY variable contains the PATH to the node executable.
export NODE_BINARY=$(command -v node)

# Last-resort fallback so NODE_BINARY is never empty (empty -> ": command not found").
if [ -z "$NODE_BINARY" ]; then
  export NODE_BINARY=/usr/local/bin/node
fi
